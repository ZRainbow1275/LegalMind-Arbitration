# ============================================================================
# LegalMind 仲裁平台 - 环境配置示例
# ============================================================================
# 复制此文件为 .env.local 并填入实际值
# 注意：不要将 .env.local 提交到版本控制系统

# ============================================================================
# 应用基础配置
# ============================================================================
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=LegalMind仲裁平台
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_URL=http://localhost:3005

# ============================================================================
# 数据库配置 (PostgreSQL)
# ============================================================================
# 格式: postgresql://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgresql://postgres:your_password@localhost:5433/legalmind_arbitration
SHADOW_DATABASE_URL=postgresql://postgres:your_password@localhost:5433/legalmind_arbitration_shadow

# 数据库连接池配置
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_TIMEOUT=30050

# ============================================================================
# Redis 缓存配置
# ============================================================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=legalmind:

# Redis 连接配置
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=1000
REDIS_CONNECT_TIMEOUT=10000

# BullMQ / 队列
# 生产建议：Web 进程关闭（false），独立 worker 进程开启（true）
BULLMQ_RUN_WORKERS=true

# 缓存过期时间配置（秒）
CACHE_TTL_SHORT=300        # 5分钟 - 频繁变化的数据
CACHE_TTL_MEDIUM=1800      # 30分钟 - 一般数据
CACHE_TTL_LONG=3600        # 1小时 - 稳定数据
CACHE_TTL_VERY_LONG=86400  # 24小时 - 很少变化的数据

# ============================================================================
# JWT 认证配置
# ============================================================================
# 生成方法:
# - ../scripts/generate-secrets.sh
# - openssl rand -base64 48
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# 会话配置
SESSION_TIMEOUT=3600000    # 1小时（毫秒）
SESSION_MAX_AGE=86400000   # 24小时（毫秒）

# ============================================================================
# 安全配置（等保三级标准）
# ============================================================================
# CSRF 保护
# 生成方法: openssl rand -hex 16
CSRF_SECRET=your-csrf-secret-key-change-this
CSRF_TOKEN_LENGTH=32

# 密码策略
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_MAX_AGE_DAYS=90

# 登录安全
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=1800000  # 30分钟（毫秒）
LOGIN_ATTEMPT_WINDOW=900000     # 15分钟（毫秒）

# API 速率限制
RATE_LIMIT_WINDOW=60000    # 1分钟（毫秒）
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_STRICT_MODE=true

# 数据加密
# 生成方法: openssl rand -hex 16
ENCRYPTION_KEY=your-32-character-encryption-key-here
ENCRYPTION_ALGORITHM=aes-256-gcm

# 审计日志签名密钥（必须设置强随机值，长度至少 32 个字符）
# 生成方法:
# - ../scripts/generate-secrets.sh
# - openssl rand -base64 32
AUDIT_LOG_SECRET=your-audit-log-secret-change-this

# 支付回调验签密钥（可选：未配置则支付接口返回 SERVICE_NOT_CONFIGURED）
# 生成方法:
# - ../scripts/generate-secrets.sh
# - openssl rand -base64 32
PAYMENT_WEBHOOK_SECRET=your-payment-webhook-secret-change-this

# ============================================================================  
# AI 服务配置
# ============================================================================  
# OpenAI / GPT
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# 腾讯云 OCR
TENCENT_SECRET_ID=your-tencent-secret-id
TENCENT_SECRET_KEY=your-tencent-secret-key
TENCENT_OCR_REGION=ap-guangzhou

# 讯飞语音识别
IFLYTEK_APP_ID=your-iflytek-app-id
IFLYTEK_API_KEY=your-iflytek-api-key
IFLYTEK_API_SECRET=your-iflytek-api-secret

# 百度 AI
BAIDU_API_KEY=your-baidu-api-key
BAIDU_SECRET_KEY=your-baidu-secret-key

# AI 服务超时配置（毫秒）
AI_REQUEST_TIMEOUT=30050
AI_MAX_RETRIES=3

# ============================================================================
# 外部系统集成配置
# ============================================================================
# 法院数据系统
COURT_SYSTEM_API_URL=https://api.court.gov.cn
COURT_SYSTEM_API_KEY=your-court-system-api-key
COURT_SYSTEM_TIMEOUT=15000

# 公证系统
NOTARY_SYSTEM_API_URL=https://api.notary.gov.cn
NOTARY_SYSTEM_API_KEY=your-notary-system-api-key
NOTARY_SYSTEM_TIMEOUT=15000

# 法律数据库
LEGAL_DATABASE_API_URL=https://api.legaldatabase.com
LEGAL_DATABASE_API_KEY=your-legal-database-api-key
LEGAL_DATABASE_TIMEOUT=10000

# ============================================================================
# SSO 单点登录配置
# ============================================================================
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3005/api/auth/sso/google/callback

# Microsoft Azure AD
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_REDIRECT_URI=http://localhost:3005/api/auth/sso/azure/callback

# 企业微信
WECHAT_WORK_CORP_ID=your-wechat-work-corp-id
WECHAT_WORK_AGENT_ID=your-wechat-work-agent-id
WECHAT_WORK_SECRET=your-wechat-work-secret
WECHAT_WORK_REDIRECT_URI=http://localhost:3005/api/auth/sso/wechat_work/callback

# 钉钉
# 兼容：DINGTALK_APP_ID / DINGTALK_APP_KEY 二选一
DINGTALK_APP_ID=your-dingtalk-app-id
# DINGTALK_APP_KEY=your-dingtalk-app-key
DINGTALK_APP_SECRET=your-dingtalk-app-secret
DINGTALK_REDIRECT_URI=http://localhost:3005/api/auth/sso/dingtalk/callback

# 支付宝（OAuth2 + RSA2 签名；需配置开放平台密钥）
ALIPAY_APP_ID=your-alipay-app-id
ALIPAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----"
ALIPAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_PUBLIC_KEY\n-----END PUBLIC KEY-----"
ALIPAY_REDIRECT_URI=http://localhost:3005/api/auth/sso/alipay/callback
ALIPAY_SCOPE=auth_user
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# ============================================================================  
# 文件存储配置
# ============================================================================  
# 本地存储
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800  # 50MB（字节）
ALLOWED_FILE_TYPES=pdf,doc,docx,jpg,jpeg,png,txt,xlsx,xls

# MinIO / S3（D4A：上传即证据，推荐）
# 需先启动根目录 docker-compose.yml 中的 minio（默认端口映射：9100->9000）
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=legalmind-evidence
S3_ACCESS_KEY_ID=your-minio-access-key
S3_SECRET_ACCESS_KEY=your-minio-secret-key
S3_FORCE_PATH_STYLE=true
S3_PRESIGNED_URL_EXPIRES_SECONDS=60
S3_SERVER_SIDE_ENCRYPTION=AES256

# 阿里云 OSS（可选）
ALIYUN_OSS_REGION=oss-cn-hangzhou
ALIYUN_OSS_ACCESS_KEY_ID=your-aliyun-access-key-id
ALIYUN_OSS_ACCESS_KEY_SECRET=your-aliyun-access-key-secret
ALIYUN_OSS_BUCKET=legalmind-arbitration
ALIYUN_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com

# ============================================================================
# 邮件服务配置
# ============================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=noreply@legalmind.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_NAME=LegalMind仲裁平台
SMTP_FROM_EMAIL=noreply@legalmind.com

# ============================================================================
# 短信服务配置
# ============================================================================
SMS_PROVIDER=aliyun  # aliyun, tencent, twilio
SMS_ACCESS_KEY_ID=your-sms-access-key-id
SMS_ACCESS_KEY_SECRET=your-sms-access-key-secret
SMS_SIGN_NAME=LegalMind
SMS_TEMPLATE_CODE=SMS_123456789

# 场景化模板（可选；未设置则回退 SMS_TEMPLATE_CODE）
SMS_TEMPLATE_CODE_VERIFY_PHONE=SMS_123456789
SMS_TEMPLATE_CODE_NOTIFICATION=SMS_123456789
SMS_TEMPLATE_CODE_SERVICE=SMS_123456789

# ============================================================================  
# WebRTC 视频会议配置
# ============================================================================  
# LiveKit（推荐，用于视频庭审）
# - 若使用根目录 docker-compose.yml 提供的 livekit 服务，默认 URL 为 ws://localhost:7880
# - 生产环境请使用 wss:// 并配置反向代理与 TLS
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_TOKEN_TTL_SECONDS=600

WEBRTC_STUN_SERVER=stun:stun.l.google.com:19302
WEBRTC_TURN_SERVER=turn:your-turn-server.com:3478
WEBRTC_TURN_USERNAME=your-turn-username
WEBRTC_TURN_PASSWORD=your-turn-password

# ============================================================================
# 日志配置
# ============================================================================
LOG_LEVEL=info  # error, warn, info, debug
LOG_FILE_PATH=./logs
LOG_MAX_SIZE=10485760  # 10MB
LOG_MAX_FILES=30
LOG_COMPRESS=true

# 审计日志配置
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=365
AUDIT_LOG_ENCRYPTION=true

# ============================================================================
# 监控和性能配置
# ============================================================================
# Sentry 错误监控（可选）
SENTRY_DSN=your-sentry-dsn
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# 性能监控
PERFORMANCE_MONITORING=true
SLOW_QUERY_THRESHOLD=1000  # 慢查询阈值（毫秒）
API_TIMEOUT=30050          # API超时时间（毫秒）

# ============================================================================
# 开发工具配置
# ============================================================================
# 是否启用调试模式
DEBUG_MODE=false
DEBUG_SQL=false
DEBUG_CACHE=false

# 是否启用 API 文档
ENABLE_API_DOCS=true
API_DOCS_PATH=/api-docs

# ============================================================================
# 生产环境特定配置
# ============================================================================
# 仅在生产环境使用
# FORCE_HTTPS=true
# TRUST_PROXY=true
# COMPRESSION_ENABLED=true
# HELMET_ENABLED=true

# ============================================================================
# 备份和恢复配置
# ============================================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # 每天凌晨2点
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=./backups

# ============================================================================
# 合规性配置
# ============================================================================
# 个人信息保护
DATA_RETENTION_DAYS=2555  # 7年（符合仲裁法要求）
GDPR_COMPLIANCE=true
PERSONAL_DATA_ENCRYPTION=true

# 数据脱敏
ENABLE_DATA_MASKING=true
MASK_PHONE_NUMBERS=true
MASK_ID_NUMBERS=true
MASK_EMAIL_ADDRESSES=true

# ============================================================================
# 功能开关
# ============================================================================
FEATURE_AI_ASSISTANT=true
FEATURE_VIDEO_HEARING=true
FEATURE_MEDIATION=true
FEATURE_BATCH_IMPORT=true
FEATURE_DOCUMENT_GENERATION=true
FEATURE_EXTERNAL_SYSTEMS=false  # 外部系统集成（待开发）
FEATURE_SSO=false               # SSO单点登录（待开发）

# ============================================================================
# 其他配置
# ============================================================================
TIMEZONE=Asia/Shanghai
DEFAULT_LANGUAGE=zh-CN
CURRENCY=CNY
