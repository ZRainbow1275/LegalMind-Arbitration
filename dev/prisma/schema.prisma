  @@index([provider])
  @@index([status])
  @@index([createdAt])
  @@map("hearing_recordings")
}

model HearingTranscript {
  id                String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hearingId         String                  @map("hearing_id") @db.Uuid
  recordingId       String?                 @map("recording_id") @db.Uuid
  provider          String?                 @db.VarChar(50)
  status            HearingTranscriptStatus @default(REQUESTED)
  requestedByUserId String?                 @map("requested_by_user_id") @db.Uuid

  language String? @db.VarChar(20)
  format   String? @db.VarChar(50)
