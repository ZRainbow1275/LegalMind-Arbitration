// LegalMind 仲裁平台 Prisma Schema
// 基于数据库设计文档 v0.5

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ============================================================================
// 枚举类型定义
// ============================================================================

enum UserType {
  INDIVIDUAL // 个人用户
  ENTERPRISE // 企业用户
}

enum UserStatus {
  ACTIVE // 活跃
  INACTIVE // 非活跃
  SUSPENDED // 暂停
}

enum ProfileType {
  INDIVIDUAL // 个人档案
  ENTERPRISE // 企业档案
}

enum VerificationStatus {
  PENDING // 待验证
  VERIFIED // 已验证
  REJECTED // 已拒绝
}

enum Role {
  // 平台身份（Platform Identity）
  END_USER // 普通用户（个人/企业）
  LAWYER // 律师
  ARBITRATOR // 仲裁员
  MEDIATOR // 调解员
  COURT // 法院（机构/接口账号）
  NOTARY // 公证机构（机构/接口账号）
  ADMIN // 业务管理员（仲裁机构/平台管理员）
  OPS_ADMIN // 运维管理员（仅管配置/日志/权限，不参与案件事实）
  AUDITOR_READONLY // 审计只读（可选）

  // 历史/兼容（逐步迁移为案件身份）
  APPLICANT // 申请人
  RESPONDENT // 被申请人
}

enum CaseStatus {
  DRAFT // 草稿
  SUBMITTED // 已提交
  ACCEPTED // 已受理
  IN_PROGRESS // 进行中
  MEDIATION // 调解中
  HEARING // 庭审中
  DELIBERATION // 合议中
  COMPLETED // 已完成
  CLOSED // 已关闭
  CANCELLED // 已取消
}

enum Priority {
  LOW // 低优先级
  MEDIUM // 中优先级
  HIGH // 高优先级
  URGENT // 紧急
}

enum ParticipantType {
  // 当事与代理
  APPLICANT // 申请人
  RESPONDENT // 被申请人
  AGENT // 代理人（含律师/授权代理）

  // 中立者与程序参与
  ARBITRATOR // 仲裁员
  PRESIDING_ARBITRATOR // 首席仲裁员（可选）
  MEDIATOR // 调解员
  CLERK // 书记员（可选）
  WITNESS // 证人（可选）
  OBSERVER // 观察员（只读，可选）

  // 机构参与（接口型参与）
  COURT // 法院
  NOTARY // 公证机构
}

enum DocumentType {
  APPLICATION // 申请书
  EVIDENCE // 证据
  RESPONSE // 答辩书
  DECISION // 裁决书
  AGREEMENT // 协议
  OTHER // 其他
}

enum PaymentMethod {
  WECHAT
  ALIPAY
}

enum PaymentOrderStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELED
  REFUNDED
}

enum ServiceChannel {
  EMAIL
  SMS
  PUSH
}

enum ServiceStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
  CANCELED
}

enum ServiceAttemptStatus {
  PENDING
  DELIVERED
  FAILED
  RETRYING
  NOT_IMPLEMENTED
  SERVICE_NOT_CONFIGURED
}

enum ArchiveStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum HearingStatus {
  SCHEDULED // 已安排
  PREPARING // 准备中
  IN_PROGRESS // 进行中
  PAUSED // 暂停
  COMPLETED // 已完成
  CANCELLED // 已取消
}

enum HearingType {
  INITIAL // 首次庭审
  EVIDENCE // 举证质证
  DEBATE // 辩论
  FINAL // 最终庭审
}

enum MediationStatus {
  PENDING_APPROVAL // 待批准
  APPROVED // 已批准
  IN_PROGRESS // 进行中
  AGREEMENT_DRAFT // 协议草案
  AGREEMENT_SIGNED // 协议已签署
  JUDICIAL_CONFIRMATION_PENDING // 司法确认中
  JUDICIAL_CONFIRMED // 司法确认完成
  COMPLETED // 已完成
  FAILED // 调解失败
}

enum NotificationType {
  CASE_UPDATE // 案件更新
  HEARING_REMINDER // 庭审提醒
  DOCUMENT_UPLOADED // 文档上传
  MEDIATION_REQUEST // 调解申请
  SYSTEM_ANNOUNCEMENT // 系统公告
  AI_SUGGESTION // AI建议
}

enum NotificationStatus {
  PENDING // 待发送
  DELIVERED // 已送达
  READ // 已读
  ARCHIVED // 已归档
}

enum ProcessStage {
  CASE_FILING // 立案
  CASE_ACCEPTANCE // 受理
  ARBITRATOR_APPOINTMENT // 仲裁员指定
  EVIDENCE_EXCHANGE // 证据交换
  HEARING_PREPARATION // 庭审准备
  HEARING_CONDUCT // 庭审进行
  DELIBERATION // 合议
  AWARD_DRAFTING // 裁决书起草
  AWARD_ISSUANCE // 裁决书发出
  CASE_CLOSURE // 案件结案
}

// ============================================================================
// 邀请/合意/任命（M2）相关枚举
// ============================================================================

enum NeutralType {
  ARBITRATOR
  MEDIATOR
}

enum InvitationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
}

enum NeutralResponseAction {
  ACCEPT
  REJECT
  REQUEST_MORE_TIME
  UPDATE_DISCLOSURE
}

enum PartyConsentDecision {
  PENDING
  CONSENTED
  REJECTED
  WITHDRAWN
}

enum PartyConsentStatus {
  PENDING
  CONSENTED_BOTH
  WITHDRAWN
  EFFECTIVE
}

enum AppointmentStatus {
  PENDING
  ACTIVE
  TERMINATED
}

// ============================================================================
// 后端补齐（审计后续）：案件受理/仲裁员/回避/任务/证据/签章/录制/大文件上传
// ============================================================================

enum CaseReviewStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  NEED_MORE_INFO
  WITHDRAWN
}

enum ArbitratorProfileStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum ArbitratorAvailabilityStatus {
  AVAILABLE
  BLOCKED
  BOOKED
}

enum ArbitratorReviewStatus {
  PENDING_MODERATION
  PUBLISHED
  HIDDEN
}

enum RecusalRequestStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
}

enum CaseTaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELED
}

enum EvidenceVerificationMethod {
  HASH
  NOTARY
}

enum EvidenceVerificationStatus {
  PENDING
  PROCESSING
  VERIFIED
  FAILED
  NOT_SUPPORTED
  SERVICE_NOT_CONFIGURED
}

enum DocumentSignatureRequestStatus {
  DRAFT
  REQUESTED
  COMPLETED
  CANCELED
}

enum DocumentSignatureStatus {
  PENDING
  SIGNED
  DECLINED
  EXPIRED
  CANCELED
}

enum SealStatus {
  ACTIVE
  INACTIVE
  REVOKED
}

enum SealUsageStatus {
  APPLIED
  REVOKED
}

enum HearingRecordingStatus {
  REQUESTED
  RUNNING
  COMPLETED
  FAILED
  STOPPED
}

enum HearingTranscriptStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  FAILED
  NOT_SUPPORTED
  SERVICE_NOT_CONFIGURED
}

enum MultipartUploadStatus {
  INITIATED
  UPLOADING
  COMPLETED
  ABORTED
  FAILED
}

// ============================================================================
// 用户相关模型
// ============================================================================

model User {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String     @unique @db.VarChar(255)
  phone         String?    @unique @db.VarChar(20)
  passwordHash  String     @map("password_hash") @db.VarChar(255)
  userType      UserType   @map("user_type")
  status        UserStatus @default(ACTIVE)
  emailVerified Boolean    @default(false) @map("email_verified")
  phoneVerified Boolean    @default(false) @map("phone_verified")
  lastLoginAt   DateTime?  @map("last_login_at") @db.Timestamptz
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  // 关联关系
  profile            UserProfile?
  roles              UserRole[]
  externalIdentities ExternalIdentity[]
  applicantCases     ArbitrationCase[]  @relation("ApplicantCases")
  respondentCases    ArbitrationCase[]  @relation("RespondentCases")
  caseParticipants   CaseParticipant[]
  uploadedDocuments  CaseDocument[]
  assignedRoles      UserRole[]         @relation("AssignedBy")
  mfa                UserMfa?

  // 新增关联关系
  createdHearings        Hearing[]            @relation("HearingCreator")
  hearingParticipations  HearingParticipant[] @relation("HearingParticipantUser")
  mediationApplications  Mediation[]          @relation("MediationApplicant")
  mediationAssignments   Mediation[]          @relation("MediationMediator")
  createdAgreements      MediationAgreement[] @relation("AgreementCreator")
  notifications          Notification[]       @relation("UserNotifications")
  createdTemplates       DocumentTemplate[]   @relation("TemplateCreator")
  generatedDocuments     GeneratedDocument[]  @relation("DocumentGenerator")
  batchOperations        BatchOperation[]     @relation("BatchOperationCreator")
  paymentOrders          PaymentOrder[]       @relation("PaymentOrderPayer")
  serviceRequests        ServiceOfProcess[]   @relation("ServiceRequestedBy")
  archivePackagesCreated ArchivePackage[]     @relation("ArchivePackageCreator")
  auditLogs              AuditLog[]

  // 后端补齐：仲裁员/任务/回避/受理/签章/证据/录制/大文件上传
  arbitratorProfile           ArbitratorProfile?
  verifiedArbitratorProfiles  ArbitratorProfile[]          @relation("ArbitratorProfileVerifier")
  arbitratorAvailabilitySlots ArbitratorAvailabilitySlot[] @relation("ArbitratorAvailabilityUser")
  arbitratorReviewsReceived   ArbitratorReview[]           @relation("ArbitratorReviewTarget")
  arbitratorReviewsGiven      ArbitratorReview[]           @relation("ArbitratorReviewAuthor")

  caseReviewsSubmitted CaseReview[] @relation("CaseReviewSubmitter")
  caseReviewsDecided   CaseReview[] @relation("CaseReviewDecider")

  recusalRequestsCreated  RecusalRequest[] @relation("RecusalRequestCreator")
  recusalRequestsTargeted RecusalRequest[] @relation("RecusalRequestTarget")
  recusalRequestsDecided  RecusalRequest[] @relation("RecusalRequestDecider")

  caseTasksCreated       CaseTask[]       @relation("CaseTaskCreator")
  taskAssignments        TaskAssignment[] @relation("TaskAssignmentUser")
  taskAssignmentsCreated TaskAssignment[] @relation("TaskAssignmentAssigner")
  taskComments           TaskComment[]    @relation("TaskCommentAuthor")

  signatureRequestsCreated DocumentSignatureRequest[] @relation("DocumentSignatureRequestCreator")
  documentSignatures       DocumentSignature[]        @relation("DocumentSignatureSigner")
  sealsOwned               Seal[]                     @relation("SealOwner")
  sealUsages               SealUsage[]                @relation("SealUsageActor")

  evidenceVerificationsRequested EvidenceVerification[] @relation("EvidenceVerificationRequester")

  hearingRecordingsRequested  HearingRecording[]  @relation("HearingRecordingRequester")
  hearingRecordingsStopped    HearingRecording[]  @relation("HearingRecordingStopper")
  hearingTranscriptsRequested HearingTranscript[] @relation("HearingTranscriptRequester")

  multipartUploads MultipartUploadSession[] @relation("MultipartUploadUser")

  // 邀请/披露/合意/任命（M2）与业务事件
  neutralInvitationsReceived NeutralInvitation[]  @relation("NeutralInvitationInvitedUser")
  neutralInvitationsSent     NeutralInvitation[]  @relation("NeutralInvitationInvitedByUser")
  conflictDisclosures        ConflictDisclosure[] @relation("ConflictDisclosureCreator")
  neutralResponses           NeutralResponse[]    @relation("NeutralResponseActor")
  partyConsentTargets        PartyConsent[]       @relation("PartyConsentTargetUser")
  neutralAppointments        NeutralAppointment[] @relation("NeutralAppointmentTargetUser")
  createdNeutralAppointments NeutralAppointment[] @relation("NeutralAppointmentCreator")
  caseEvents                 CaseEvent[]          @relation("CaseEventActor")

  @@index([email])
  @@index([phone])
  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model UserProfile {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String      @unique @map("user_id") @db.Uuid
  profileType ProfileType @map("profile_type")

  // 个人用户字段
  realName             String? @map("real_name") @db.VarChar(100)
  idNumber             String? @map("id_number") @db.VarChar(18)
  idCardFrontUrl       String? @map("id_card_front_url")
  idCardBackUrl        String? @map("id_card_back_url")
  faceVerificationData String? @map("face_verification_data")

  // 企业用户字段
  companyName         String? @map("company_name") @db.VarChar(200)
  businessLicense     String? @map("business_license") @db.VarChar(50)
  legalRepresentative String? @map("legal_representative") @db.VarChar(100)
  legalRepIdNumber    String? @map("legal_rep_id_number") @db.VarChar(18)
  companyAddress      String? @map("company_address")

  // 通用字段
  verificationStatus    VerificationStatus @default(PENDING) @map("verification_status")
  verificationDocuments Json?              @map("verification_documents")
  verifiedAt            DateTime?          @map("verified_at") @db.Timestamptz
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  // 关联关系
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([verificationStatus])
  @@map("user_profiles")
}

model UserRole {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  role        Role
  permissions Json? // 权限列表
  isActive    Boolean  @default(true) @map("is_active")
  assignedAt  DateTime @default(now()) @map("assigned_at") @db.Timestamptz
  assignedBy  String?  @map("assigned_by") @db.Uuid

  // 关联关系
  user           User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedByUser User? @relation("AssignedBy", fields: [assignedBy], references: [id])

  @@unique([userId, role])
  @@index([userId])
  @@index([role])
  @@map("user_roles")
}

// 多因素认证（TOTP）配置
model UserMfa {
  userId        String    @id @map("user_id") @db.Uuid
  totpSecretEnc String    @map("totp_secret_enc") @db.Text
  enabled       Boolean   @default(false)
  verifiedAt    DateTime? @map("verified_at") @db.Timestamptz
  recoveryCodes Json?     @map("recovery_codes")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_mfa")
}

// 外部身份（OIDC 等）与本地用户映射
model ExternalIdentity {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid

  providerType String @map("provider_type") @db.VarChar(50) // 例如: OIDC
  issuer       String @db.VarChar(500)
  subject      String @db.VarChar(255)

  email         String?  @db.VarChar(255)
  emailVerified Boolean? @map("email_verified")
  rawClaims     Json?    @map("raw_claims")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz

  // 关联关系
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, subject])
  @@index([userId])
  @@index([email])
  @@map("external_identities")
}

// ============================================================================
// ============================================================================
// 仲裁员管理（资质/评价/可用性）
// ============================================================================

model ArbitratorProfile {
  id     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String                  @unique @map("user_id") @db.Uuid
  status ArbitratorProfileStatus @default(DRAFT)

  title           String?  @db.VarChar(200)
  bio             String?  @db.Text
  experienceYears Int      @default(0) @map("experience_years")
  location        String?  @db.VarChar(100)
  languages       Json?    @map("languages")
  specialties     Json?    @map("specialties")
  hourlyRate      Decimal? @map("hourly_rate") @db.Decimal(10, 2)

  verificationDocuments Json?     @map("verification_documents")
  verifiedAt            DateTime? @map("verified_at") @db.Timestamptz
  verifiedByUserId      String?   @map("verified_by_user_id") @db.Uuid

  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user           User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifiedByUser User? @relation("ArbitratorProfileVerifier", fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([verifiedAt])
  @@index([verifiedByUserId])
  @@map("arbitrator_profiles")
}

model ArbitratorReview {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  arbitratorUserId String  @map("arbitrator_user_id") @db.Uuid
  caseId           String? @map("case_id") @db.Uuid
  authorUserId     String  @map("author_user_id") @db.Uuid

  rating   Int
  content  String?                @db.Text
  status   ArbitratorReviewStatus @default(PENDING_MODERATION)
  metadata Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  arbitrator User             @relation("ArbitratorReviewTarget", fields: [arbitratorUserId], references: [id], onDelete: Cascade)
  case       ArbitrationCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  author     User             @relation("ArbitratorReviewAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)

  @@unique([caseId, authorUserId, arbitratorUserId])
  @@index([arbitratorUserId])
  @@index([caseId])
  @@index([authorUserId])
  @@index([status])
  @@map("arbitrator_reviews")
}

model ArbitratorAvailabilitySlot {
  id               String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  arbitratorUserId String                       @map("arbitrator_user_id") @db.Uuid
  status           ArbitratorAvailabilityStatus @default(AVAILABLE)
  startAt          DateTime                     @map("start_at") @db.Timestamptz
  endAt            DateTime                     @map("end_at") @db.Timestamptz
  timezone         String                       @default("Asia/Shanghai") @db.VarChar(50)
  note             String?                      @db.VarChar(200)
  metadata         Json?
  createdAt        DateTime                     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime                     @updatedAt @map("updated_at") @db.Timestamptz

  arbitrator User @relation("ArbitratorAvailabilityUser", fields: [arbitratorUserId], references: [id], onDelete: Cascade)

  @@index([arbitratorUserId])
  @@index([status])
  @@index([startAt])
  @@index([endAt])
  @@map("arbitrator_availability_slots")
}

// 案件相关模型
// ============================================================================

model ArbitrationCase {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseNumber    String   @unique @map("case_number") @db.VarChar(50)
  title         String   @db.VarChar(500)
  description   String?
  caseType      String   @map("case_type") @db.VarChar(100)
  disputeAmount Decimal? @map("dispute_amount") @db.Decimal(15, 2)
  currency      String   @default("CNY") @db.VarChar(3)

  // 当事人信息
  applicantId    String  @map("applicant_id") @db.Uuid
  respondentId   String? @map("respondent_id") @db.Uuid
  respondentInfo Json?   @map("respondent_info") // 被申请人详细信息（可能未注册）

  // 案件状态
  status   CaseStatus @default(DRAFT)
  priority Priority   @default(MEDIUM)

  // 重要文档
  arbitrationAgreementUrl String? @map("arbitration_agreement_url")
  applicationFormUrl      String? @map("application_form_url")

  // 时间信息
  submittedAt DateTime? @map("submitted_at") @db.Timestamptz
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz
  deadline    DateTime? @db.Timestamptz
  completedAt DateTime? @map("completed_at") @db.Timestamptz

  // 费用信息
  arbitrationFee Decimal?  @map("arbitration_fee") @db.Decimal(10, 2)
  feePaid        Boolean   @default(false) @map("fee_paid")
  feePaidAt      DateTime? @map("fee_paid_at") @db.Timestamptz

  // 元数据
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // 关联关系
  applicant           User                 @relation("ApplicantCases", fields: [applicantId], references: [id])
  respondent          User?                @relation("RespondentCases", fields: [respondentId], references: [id])
  participants        CaseParticipant[]
  documents           CaseDocument[]
  neutralInvitations  NeutralInvitation[]
  partyConsents       PartyConsent[]
  neutralAppointments NeutralAppointment[]
  caseEvents          CaseEvent[]

  // 新增关联关系
  hearings           Hearing[]
  mediations         Mediation[]
  generatedDocuments GeneratedDocument[]
  paymentOrders      PaymentOrder[]
  serviceOfProcess   ServiceOfProcess[]
  archivePackages    ArchivePackage[]
  arbitrationProcess ArbitrationProcess?
  canvas             CaseCanvas?

  // 后端补齐：受理/回避/任务/签章/印章/大文件上传
  review            CaseReview?
  recusalRequests   RecusalRequest[]
  tasks             CaseTask[]
  signatureRequests DocumentSignatureRequest[]
  sealUsages        SealUsage[]
  multipartUploads  MultipartUploadSession[]
  arbitratorReviews ArbitratorReview[]

  @@index([caseNumber])
  @@index([applicantId])
  @@index([respondentId])
  @@index([status])
  @@index([createdAt])
  @@index([disputeAmount])
  @@map("arbitration_cases")
}

// ============================================================================
// 案件受理/审核（工作流留痕）
// ============================================================================

model CaseReview {
  id     String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId String           @unique @map("case_id") @db.Uuid
  status CaseReviewStatus @default(SUBMITTED)

  submittedByUserId String    @map("submitted_by_user_id") @db.Uuid
  submittedAt       DateTime  @default(now()) @map("submitted_at") @db.Timestamptz
  decidedByUserId   String?   @map("decided_by_user_id") @db.Uuid
  decidedAt         DateTime? @map("decided_at") @db.Timestamptz
  decisionReason    String?   @map("decision_reason") @db.Text
  metadata          Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  case            ArbitrationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  submittedByUser User            @relation("CaseReviewSubmitter", fields: [submittedByUserId], references: [id])
  decidedByUser   User?           @relation("CaseReviewDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@index([status])
