model Hearing {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hearingNumber     String        @unique @map("hearing_number") @db.VarChar(50)
  caseId            String        @map("case_id") @db.Uuid
  title             String        @db.VarChar(200)
  description       String?       @db.Text
  hearingType       HearingType   @map("hearing_type")
  status            HearingStatus @default(SCHEDULED)
  isOnline          Boolean       @default(true) @map("is_online")
  scheduledAt       DateTime      @map("scheduled_at") @db.Timestamptz
  startedAt         DateTime?     @map("started_at") @db.Timestamptz
  endedAt           DateTime?     @map("ended_at") @db.Timestamptz
  estimatedDuration Int           @default(120) @map("estimated_duration") // 分钟
  actualDuration    Int?          @map("actual_duration") // 分钟

  // 技术配置
  webrtcConfig     Json?   @map("webrtc_config")
  recordingEnabled Boolean @default(true) @map("recording_enabled")
  recordingUrl     String? @map("recording_url") @db.VarChar(500)
  transcriptUrl    String? @map("transcript_url") @db.VarChar(500)

  // AI功能
  aiFeatures Json? @map("ai_features")
  aiAnalysis Json? @map("ai_analysis")

  // 审计字段
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // 关联关系
  case         ArbitrationCase      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  creator      User                 @relation("HearingCreator", fields: [createdBy], references: [id])
  participants HearingParticipant[]
  recordings   HearingRecording[]
  transcripts  HearingTranscript[]

  @@index([caseId])
  @@index([status])
  @@index([scheduledAt])
  @@index([createdBy])
  @@index([hearingNumber])
  @@map("hearings")
}

model HearingParticipant {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hearingId  String          @map("hearing_id") @db.Uuid
  userId     String?         @map("user_id") @db.Uuid
