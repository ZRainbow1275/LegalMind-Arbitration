model HearingRecording {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hearingId        String                 @map("hearing_id") @db.Uuid
  provider         String                 @db.VarChar(50)
  providerEgressId String?                @map("provider_egress_id") @db.VarChar(200)
  status           HearingRecordingStatus @default(REQUESTED)

  requestedByUserId String?   @map("requested_by_user_id") @db.Uuid
  stoppedByUserId   String?   @map("stopped_by_user_id") @db.Uuid
  startedAt         DateTime? @map("started_at") @db.Timestamptz
  endedAt           DateTime? @map("ended_at") @db.Timestamptz

  bucket      String? @db.VarChar(255)
  objectKey   String? @map("object_key") @db.Text
  fileName    String? @map("file_name") @db.VarChar(255)
  contentType String? @map("content_type") @db.VarChar(100)
  size        BigInt? @map("size")
  sha256      String? @db.VarChar(64)

  metadata  Json?
  error     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  hearing         Hearing             @relation(fields: [hearingId], references: [id], onDelete: Cascade)
  requestedByUser User?               @relation("HearingRecordingRequester", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  stoppedByUser   User?               @relation("HearingRecordingStopper", fields: [stoppedByUserId], references: [id], onDelete: SetNull)
