// ============================================================================
// 100MB+ 上传：对象存储 multipart 会话（防止只靠 formData 走内存）
// ============================================================================

model MultipartUploadSession {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String  @map("user_id") @db.Uuid
  caseId String? @map("case_id") @db.Uuid

  uploadId  String @map("upload_id") @db.VarChar(200)
  bucket    String @db.VarChar(255)
  objectKey String @map("object_key") @db.Text

  fileName     String @map("file_name") @db.VarChar(255)
  originalName String @map("original_name") @db.VarChar(255)
  contentType  String @map("content_type") @db.VarChar(100)
  fileSize     BigInt @map("file_size")

  status      MultipartUploadStatus @default(INITIATED)
  parts       Json?                 @map("parts")
  completedAt DateTime?             @map("completed_at") @db.Timestamptz
  error       String?               @db.Text
  metadata    Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User             @relation("MultipartUploadUser", fields: [userId], references: [id], onDelete: Cascade)
  case ArbitrationCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@unique([bucket, objectKey, uploadId])
  @@index([userId])
  @@index([caseId])
  @@index([status])
  @@index([createdAt])
  @@map("multipart_upload_sessions")
}

